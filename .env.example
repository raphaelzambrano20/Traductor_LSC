# Copia este archivo como .env y reemplaza los valores. El archivo .env NO se sube a git.
# Genera valores nuevos con:
#   venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(32))"

# Llave de sesiones de Flask (puede ser distinta en cada computador).
LSC_SECRET_KEY=

# Contraseña del modo desarrollador (/dev).
LSC_DEV_PASSWORD=
